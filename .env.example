# Aucune valeur réelle ici. Le vrai .env reste hors dépôt.
NODE_ENV=development
DATABASE_URL=postgresql://organizer:organizer@127.0.0.1:55432/organizer
REDIS_URL=redis://127.0.0.1:56379/0

# polling en dev (bot de dev distinct du bot de production), webhook en production
TELEGRAM_MODE=polling
# Chemins relatifs à la racine du dépôt (un chemin absolu est gardé tel quel)
PROMPTS_DIR=prompts
PROMPT_VERSION=tri/v1
# Valeurs de usageMetadata.serviceTier acceptées comme palier payé
GEMINI_TIERS_PAYES=standard
WORKER_CONCURRENCY=2

# Gemini — projet Google Cloud AVEC FACTURATION ACTIVÉE.
# Le palier gratuit est interdit : son contenu sert à entraîner des modèles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.app.created

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

HOME_ASSISTANT_WEBHOOK_URL=
# Relatif à la racine du dépôt : l'API et le worker lisent le même dossier
AUDIO_STORAGE_PATH=./data/audio
TZ=Europe/Paris
