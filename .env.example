# Aucune valeur réelle ici. Le vrai .env reste hors dépôt.
NODE_ENV=development
DATABASE_URL=postgresql://organizer:changeme@localhost:5432/organizer
REDIS_URL=redis://localhost:6379

# Gemini — projet Google Cloud AVEC FACTURATION ACTIVÉE.
# Le palier gratuit est interdit : son contenu sert à entraîner des modèles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.app.created

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

HOME_ASSISTANT_WEBHOOK_URL=
AUDIO_STORAGE_PATH=./data/audio
TZ=Europe/Paris
