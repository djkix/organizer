    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.34.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
