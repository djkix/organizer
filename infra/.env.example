# Configuration de la stack de production. Copier en infra/.env (ignoré par Git).
# Les clés d'API vont dans infra/secrets/, un fichier par secret, jamais ici.

ORGANIZER_VERSION=
POSTGRES_PASSWORD=
BACKUP_GPG_PASSPHRASE=
# Partage NFS du NAS monté sur l'hôte, ex. /mnt/nas/organizer
BACKUP_ARCHIVE_DIR=
# Système de fichiers de 50 Go qui porte tous les volumes (décision 12)
ORGANIZER_DATA_DIR=/srv/organizer
# Rotation de l'audio ordinaire : seuils en % d'occupation, âge minimal en jours
AUDIO_ROTATION_HIGH_PCT=85
AUDIO_ROTATION_LOW_PCT=75
AUDIO_ROTATION_MIN_AGE_DAYS=30

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.8-flash
VAPID_PUBLIC_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# Fichiers attendus dans infra/secrets/ (contenu brut, sans retour à la ligne final) :
#   gemini_api_key
#   telegram_bot_token
#   telegram_webhook_secret
#   vapid_private_key
#   home_assistant_webhook_url
#   google_oauth_client_secret
