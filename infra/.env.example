# Configuration de la stack de production. Copier en infra/.env (ignoré par Git).
# Les clés d'API vont dans infra/secrets/, un fichier par secret, jamais ici.

ORGANIZER_VERSION=
POSTGRES_PASSWORD=
# Rotation de l'audio : purge au-delà de MAX, jusqu'à TARGET (Go), jamais avant MIN_AGE jours
AUDIO_ROTATION_MAX_GB=40
AUDIO_ROTATION_TARGET_GB=35
AUDIO_ROTATION_MIN_AGE_DAYS=30

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.8-flash
VAPID_PUBLIC_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# ------------------------------------------------------------------
# CLÉS TELEGRAM, GEMINI, ETC. : NE PAS LES METTRE DANS CE FICHIER.
# Chaque clé est dans son propre fichier, dans le dossier infra/secrets/ :
#   infra/secrets/telegram_bot_token       jeton du bot Telegram
#   infra/secrets/telegram_webhook_secret  secret du webhook Telegram
#   infra/secrets/gemini_api_key           clé de l'API Gemini
# Lot 1, plus tard : vapid_private_key, home_assistant_webhook_url,
#   google_oauth_client_secret
# Un fichier = la valeur seule, sans « NOM= », sans guillemets.
# ------------------------------------------------------------------
