# Front statique de la PWA. L'API est routée directement vers api:3000
# par le Nginx Proxy Manager sur /api, sans passer par Caddy.
:80 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
